# Copy to .env and fill in for local/docker use.

SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=sqlite:////app/instance/parts.db

# Shown as the browser tab title and nav-bar brand in the web UI.
SITE_TITLE=PMS

# Set to true once PMS is served over HTTPS (e.g. behind a reverse proxy).
# Leave false on plain HTTP, or browsers will drop the login cookie.
SESSION_COOKIE_SECURE=false

# Ports on the host machine for the web interface and the MCP server.
WEB_PORT=5000
MCP_PUBLIC_PORT=8000

PMS_API_BASE_URL=http://web:5000

# Where the MCP server listens inside its container (not the host port).
MCP_HOST=0.0.0.0
MCP_PORT=8000
